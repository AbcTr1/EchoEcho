-- == component builders ==
local ELEM_W = UDim2.new(1, -6, 0, 40)

local function toggle(parent, label, default, callback)
    local state = default and true or false
    local row = new("Frame", {
        Size = ELEM_W,
        BackgroundColor3 = Theme.panel,
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(8, row)

    local lbl = new("TextLabel", {
        Text = label,
        Font = Theme.font,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        Parent = row,
    })

    local track = new("Frame", {
        Size = UDim2.fromOffset(38, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = state and Theme.accent or Theme.panelAlt,
        BorderSizePixel = 0,
        Parent = row,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = track,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local hit = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = row,
    })

    local function render()
        tween(track, 0.15, { BackgroundColor3 = state and Theme.accent or Theme.panelAlt })
        tween(knob, 0.15, {
            Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        })
    end

    hit.MouseButton1Click:Connect(function()
        state = not state
        render()
        callback(state)
    end)

    render()
    return row
end

local function slider(parent, label, min, max, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, -6, 0, 56),
        BackgroundColor3 = Theme.panel,
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(8, row)

    local lbl = new("TextLabel", {
        Text = label,
        Font = Theme.font,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 0, 20),
        Position = UDim2.new(0, 12, 0, 6),
        Parent = row,
    })

    local valueLbl = new("TextLabel", {
        Text = tostring(default),
        Font = Theme.font,
        TextSize = 13,
        TextColor3 = Theme.accentAlt,
        TextXAlignment = Enum.TextXAlignment.Right,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 60, 0, 20),
        Position = UDim2.new(1, -72, 0, 6),
        Parent = row,
    })

    local bar = new("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 38),
        BackgroundColor3 = Theme.panelAlt,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(3, bar)

    local fill = new("Frame", {
        Size = UDim2.fromScale((default - min) / (max - min), 1),
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
        Parent = bar,
    })
    corner(3, fill)

    local dragging = false

    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.fromScale(rel, 1)
        valueLbl.Text = tostring(val)
        callback(val)
    end

    local hit = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 0, 30),
        Parent = row,
    })
    hit.MouseButton1Down:Connect(function()
        dragging = true
        setFromX(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    valueLbl.Text = tostring(default)
    return row
end

local function button(parent, label, callback)
    local btn = new("TextButton", {
        Text = label,
        Font = Theme.font,
        TextSize = 13,
        TextColor3 = Theme.text,
        BackgroundColor3 = Theme.panel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -6, 0, 38),
        Parent = parent,
    })
    corner(8, btn)
    local s = stroke(Theme.line, 1, 0.3, btn)
    btn.MouseEnter:Connect(function()
        tween(btn, 0.12, { BackgroundColor3 = Theme.panelAlt })
        s.Color = Theme.accent
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.12, { BackgroundColor3 = Theme.panel })
        s.Color = Theme.line
    end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

