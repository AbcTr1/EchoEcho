local function selectTab(name)
    activeTab = name
    for n, btn in pairs(tabBtns) do
        local on = (n == name)
        tween(btn, 0.15, { BackgroundColor3 = on and Theme.panelAlt or Theme.panel })
        btn.TextColor3 = on and Theme.text or Theme.subtext
        btn.Text = (on and "▸ " or "  ") .. n
    end
    for n, pg in pairs(pages) do
        pg.Visible = (n == name)
    end
end

