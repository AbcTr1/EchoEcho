-- == ESP engine ==
local function buildESP(plr)
    if not plr.Character then return end
    local hl = plr.Character:FindFirstChild("ollieESP")
    if Flags.ESP and not hl then
        local box = Instance.new("Highlight")
        box.Name = "ollieESP"
        box.FillColor = Theme.accentAlt
        box.FillTransparency = 0.75
        box.OutlineColor = Theme.accent
        box.OutlineTransparency = 0
        box.Adornee = plr.Character
        box.Parent = plr.Character
    elseif not Flags.ESP and hl then
        hl:Destroy()
    end
end

local function refreshESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            buildESP(plr)
        end
    end
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function() task.wait(0.2) buildESP(plr) end)
end)

-- == core loops ==
-- Infinite jump + fly
UserInputService.JumpRequest:Connect(function()
    if Flags.InfiniteJump then
        local h = getHum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Fly (velocity-based, character moves toward camera look vector)
local flyConn
local function startFly()
    local h = getHum()
    local root = h and h.Parent and h.Parent:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local bv = root:FindFirstChild("ollieFly") or Instance.new("BodyVelocity")
    bv.Name = "ollieFly"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    flyConn = RunService.RenderStepped:Connect(function()
        if not Flags.Fly then
            bv:Destroy()
            if flyConn then flyConn:Disconnect() end
            return
        end
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
        bv.Velocity = move.Magnitude > 0 and move.Unit * Flags.FlySpeed or Vector3.zero
    end)
end

-- Noclip + walk speed enforcement + fly trigger + anti-afk + esp refresh via one heartbeat
local accum = 0
RunService.Heartbeat:Connect(function(dt)
    accum += dt

    -- walk speed / jump keepalive
    local h = getHum()
    if h then
        if h.WalkSpeed ~= Flags.WalkSpeed then h.WalkSpeed = Flags.WalkSpeed end
        if Flags.Noclip then
            for _, part in ipairs(getChar():GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
            end
        end
    end

    -- fly start/stop edge
    if Flags.Fly then
        local root = h and h.Parent and h.Parent:FindFirstChild("HumanoidRootPart")
        if root and not root:FindFirstChild("ollieFly") and not flyConn then
            startFly()
        end
    end

    -- anti-afk every 1s
    if Flags.AntiAFK and accum >= 1 then
        accum = 0
        local vim = game:GetService("VirtualUser")
        pcall(function() vim:CaptureController() end)
        pcall(function() vim:ClickButton2(Vector2.new()) end)
    end
end)

-- ESP refresh every 0.5s (player list churn)
task.spawn(function()
    while gui.Parent do
        refreshESP()
        task.wait(0.5)
    end
end)

-- character respawn: reapply speed/jump
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    gui.Parent = gui.Parent -- no-op keepalive
    local h = getHum()
    if h then
        h.WalkSpeed = Flags.WalkSpeed
        h.UseJumpPower = true
        h.JumpPower = Flags.JumpPower
    end
end)

-- == header drag ==
do
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

